# FE static: NEXT_PUBLIC_* di-bake saat docker build (dari .env BE).
# File ini hanya untuk npm run dev lokal. Deploy VM isi .env di BE.

NEXT_PUBLIC_IDENTITY_API_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_APP_VERSION=

SONAR_HOST_URL=
SONAR_TOKEN=
SONAR_PROJECT_KEY=

# Contact Form only: server-side Brevo API credentials (never NEXT_PUBLIC_).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_ADMIN_EMAIL=admin@cyberxatria.id
# Optional public URL of a separately hosted contact backend, baked in at build time.
# Leave empty for local /api/contact. Static preview reports unavailable if empty.
NEXT_PUBLIC_CONTACT_ENDPOINT=
